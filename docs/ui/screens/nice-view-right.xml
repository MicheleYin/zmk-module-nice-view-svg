<!-- Right-side 160x68 Nice!View status screen. -->
<component>
  <view extends="lv_obj" width="160" height="68"
        style_bg_color="0xffffff" style_pad_all="0" scrollable="false">
    <lv_image src="../assets/default_bg_right.png" x="0" y="0" />

    <zmk_status_bar field="battery.left.percent" x="142" y="7" width="12" height="3" />
    <lv_label text="L" x="132" y="2" font_size="8" />
    <zmk_status_text field="battery.left.percent" format="percent"
                     x="125" y="12" font_size="8" anchor="end" />
    <zmk_status_when field="battery.left.charge" test="equals" value="charging">
      <lv_image src="../assets/bolt.svg" x="96" y="2" width="7" height="9" />
    </zmk_status_when>

    <zmk_status_bar field="battery.right.percent" x="142" y="20" width="12" height="3" />
    <lv_label text="R" x="132" y="15" font_size="8" />
    <zmk_status_text field="battery.right.percent" format="percent"
                     x="125" y="26" font_size="8" anchor="end" />
    <zmk_status_when field="battery.right.charge" test="equals" value="charging">
      <lv_image src="../assets/bolt.svg" x="96" y="15" width="7" height="9" />
    </zmk_status_when>

    <lv_label text="LAYER" x="36" y="3" font_size="8" />
    <zmk_status_text field="layer.index" x="5" y="26" font_size="12" />

    <lv_label text="5" x="13" y="40" font_size="8" />
    <zmk_status_when field="ble.active_profile" test="equals" value="4">
      <lv_image src="../assets/profile_active.svg" x="6" y="37" width="19" height="15" />
    </zmk_status_when>
    <lv_label text="4" x="38" y="40" font_size="8" />
    <zmk_status_when field="ble.active_profile" test="equals" value="3">
      <lv_image src="../assets/profile_active.svg" x="31" y="37" width="19" height="15" />
    </zmk_status_when>
    <lv_label text="3" x="63" y="40" font_size="8" />
    <zmk_status_when field="ble.active_profile" test="equals" value="2">
      <lv_image src="../assets/profile_active.svg" x="56" y="37" width="19" height="15" />
    </zmk_status_when>
    <lv_label text="2" x="88" y="40" font_size="8" />
    <zmk_status_when field="ble.active_profile" test="equals" value="1">
      <lv_image src="../assets/profile_active.svg" x="81" y="37" width="19" height="15" />
    </zmk_status_when>
    <lv_label text="1" x="113" y="40" font_size="8" />
    <zmk_status_when field="ble.active_profile" test="equals" value="0">
      <lv_image src="../assets/profile_active.svg" x="106" y="37" width="19" height="15" />
    </zmk_status_when>

    <zmk_status_text field="output.selected" format="output-label"
                     x="156" y="61" font_size="8" anchor="end" />
    <lv_label text="LINK" x="40" y="53" font_size="8" />
    <zmk_status_when field="split.connected" test="equals" value="true">
      <lv_label text="+" x="6" y="53" font_size="8" />
    </zmk_status_when>
    <zmk_status_when field="split.connected" test="equals" value="false">
      <lv_label text="-" x="6" y="53" font_size="8" />
    </zmk_status_when>
    <zmk_status_when field="display.half" test="equals" value="right">
      <lv_label text="R" x="2" y="2" font_size="8" />
    </zmk_status_when>
  </view>
</component>
