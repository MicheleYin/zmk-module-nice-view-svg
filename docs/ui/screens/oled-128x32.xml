<!-- Compact 128x32 OLED status screen. -->
<component>
  <view extends="lv_obj" width="128" height="32"
        style_bg_color="0xffffff" style_pad_all="0" scrollable="false">

    <lv_label text="L" x="2" y="2" font_size="8" />
    <zmk_status_text field="battery.left.percent" format="percent" x="12" y="11" font_size="8" />
    <zmk_status_bar field="battery.left.percent" x="36" y="6" width="16" height="3" />

    <lv_label text="R" x="65" y="2" font_size="8" />
    <zmk_status_text field="battery.right.percent" format="percent" x="75" y="11" font_size="8" />
    <zmk_status_bar field="battery.right.percent" x="99" y="6" width="16" height="3" />

    <zmk_status_when field="display.half" test="equals" value="left">
      <lv_label text="L" x="120" y="2" font_size="8" />
    </zmk_status_when>
    <zmk_status_when field="display.half" test="equals" value="right">
      <lv_label text="R" x="120" y="2" font_size="8" />
    </zmk_status_when>

    <zmk_status_text field="output.selected" format="output-label" x="2" y="26" font_size="8" />
    <lv_label text="LAYER" x="63" y="18" font_size="8" />
    <zmk_status_text field="layer.index" x="122" y="26" font_size="12" anchor="end" />
  </view>
</component>
