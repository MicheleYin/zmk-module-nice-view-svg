<fragment>
  <lv_label text="{{label}}" x="{{label_x}}" y="{{label_y}}" font_size="8" font_family="monospace" />
  <lv_image src="../assets/battery-grid.svg" x="{{icon_x}}" y="{{icon_y}}" width="24" height="16" />
  <zmk_status_bar field="battery.{{side}}.percent" x="{{bar_x}}" y="{{bar_y}}" width="{{bar_width}}" height="3" />
  <zmk_status_text field="battery.{{side}}.percent" format="percent" x="{{value_x}}" y="{{value_y}}" font_size="10" />
  <zmk_status_when field="battery.{{side}}.charge" test="equals" value="charging">
    <lv_image src="../assets/bolt-widget.svg" x="{{charge_x}}" y="{{charge_y}}" width="8" height="10" />
  </zmk_status_when>
</fragment>