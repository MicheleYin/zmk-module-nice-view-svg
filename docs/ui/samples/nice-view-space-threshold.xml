<!-- Static PNG background with the default hard threshold. -->
<component>
  <view extends="lv_obj" width="160" height="68"
        style_bg_color="0xffffff" style_pad_all="0" scrollable="false">
    <lv_image src="../assets/astronaut-space.png" x="24" y="2"
          width="112" height="63" dither="none" />
    <lv_label text="LAY" x="2" y="4" font_size="8" font_family="monospace" />
    <zmk_status_text field="layer.index" x="2" y="16" font_size="8" />
    <lv_label text="BAT" x="2" y="36" font_size="8" font_family="monospace" />
    <zmk_status_text field="battery.left.percent" format="percent"
             x="2" y="48" font_size="8" />
    <lv_label text="OUT" x="138" y="36" font_size="8" font_family="monospace" />
    <zmk_status_text field="output.selected" format="output-label"
             x="158" y="48" font_size="8" anchor="end" />
  </view>
</component>