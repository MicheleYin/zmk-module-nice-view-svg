<fragment>
  <lv_label text="{{label}}" x="{{label_x}}" y="{{label_y}}" />
  <zmk_status_bar field="battery.{{side}}.percent" x="{{bar_x}}" y="{{bar_y}}"
                  width="{{bar_width}}" height="{{bar_height}}" />
  <zmk_status_text field="battery.{{side}}.percent" format="percent"
                    x="{{value_x}}" y="{{value_y}}" />
  <zmk_status_when field="battery.{{side}}.charge" test="equals" value="charging">
    <lv_image src="../assets/bolt.svg" x="{{charge_x}}" y="{{charge_y}}"
              width="8" height="10" />
  </zmk_status_when>
</fragment>
